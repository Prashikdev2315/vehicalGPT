{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vehiclegpt/evidence_packet.schema.json",
  "title": "Evidence packet",
  "description": "Returned by every tool. The verbaliser may only state facts present here; the verifier checks every number, date, signal name and event ID in the answer against this packet.",
  "type": "object",
  "properties": {
    "packet_id": { "type": "string", "pattern": "^ev_[0-9a-z]+$" },
    "tool": { "type": "string" },
    "query_type": { "type": "string" },
    "time_range": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 2,
      "maxItems": 2
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^f[0-9]+$" },
          "claim": { "type": "string", "description": "Short factual statement generated by code, not by the model" },
          "value": { "type": ["number", "null"] },
          "unit": { "type": ["string", "null"] },
          "contribution_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
          "relation": {
            "type": "string",
            "enum": ["attributed_contribution", "rule_backed_cause", "correlation", "observation"],
            "description": "Causal wording is allowed only for attributed_contribution and rule_backed_cause"
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "timestamps": { "type": "array", "items": { "type": "integer" } }
        },
        "required": ["id", "claim", "relation", "confidence"],
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "description": "Event rows returned by get_events / timeline_before",
      "items": {
        "type": "object",
        "properties": {
          "event_id": { "type": "integer" },
          "type": { "type": "string" },
          "ts_start": { "type": "integer" },
          "ts_end": { "type": ["integer", "null"] },
          "severity": { "type": "string" },
          "summary": { "type": "string" },
          "clip_refs": { "type": "array", "items": { "type": "integer" } }
        },
        "required": ["event_id", "type", "ts_start"],
        "additionalProperties": false
      }
    },
    "unexplained_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Handles the UI can resolve to raw signals/trips/events, e.g. trip_231, signal:hvac_power, event:88"
    },
    "data_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reason": { "type": "string", "enum": ["outside_retention", "source_missing", "signal_unknown", "no_events_found"] },
          "detail": { "type": "string" },
          "available_from": { "type": ["string", "null"] }
        },
        "required": ["reason"],
        "additionalProperties": false
      }
    },
    "display": {
      "type": "object",
      "description": "Optional chart/table hints for the UI",
      "properties": {
        "chart": { "type": "string", "enum": ["line", "bar", "timeline", "table", "none"] },
        "series": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "latency_ms": { "type": "integer", "minimum": 0 }
  },
  "required": ["packet_id", "tool", "query_type", "time_range", "findings", "evidence_refs", "data_gaps"],
  "additionalProperties": false
}
